   "outputs": [],
   "source": [
    "model = VQVAE(\n",
    "    hidden_channels=hidden_channels, \n",
    "    kernel_size = 4,\n",
    "    slope=0.1,\n",
    "    d=d,\n",
    "    n_res_layers=residual_layers, # residual hidden layers\n",
    "    res_h_dim=residual_channels # residual hidden channels\n",
    ").to(device)\n",
    "\n",
    "optimizer = optim.Adam(\n",
    "    model.parameters(), \n",
    "    lr=learning_rate, \n",
    "    amsgrad=True\n",
    ")"
   ]
