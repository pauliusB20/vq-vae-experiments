    "patches_encodings_val = [] # latent vector\n",
    "patches_pairs_val = []\n",
    "\n",
    "# Patches (training)\n",
    "patches_before_train = []\n",
    "patches_encodings_train = []\n",
    "patches_after_train = []\n",
    "\n",
    "# MSE residual averages\n",
    "average_loss_train_mse = []\n",
    "average_loss_valid_mse_val = []\n",
    "\n",
    "# perplexity\n",
    "average_perplexity_train = []\n",
    "average_perplexity_val = []\n",
